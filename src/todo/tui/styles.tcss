Screen {
    background: $surface;
}

TodoListView {
    layout: vertical;
    height: 100%;
}

#item-list {
    height: 1fr;
    min-height: 5;
}

#detail-panel {
    /* Fixed, never grown to content: a pane that swells under a long
       body squeezes the table until it covers the cursor row, and a
       preview that changes size on every cursor move is its own
       irritation. 13 rows is about five lines of body next to typical
       metadata; the full body lives in the item screen. */
    height: 13;
    padding: 1 2;
    background: $panel;
    border-top: solid $primary;
}

#detail-title {
    text-style: bold;
    margin-bottom: 1;
}

#detail-meta {
    color: $text-muted;
}

#detail-body {
    margin-top: 1;
}

#search-status {
    height: 1;
    padding: 0 1;
    background: $boost;
}

NewItemDialog {
    align: center middle;
}

NewItemDialog > #dialog-container {
    width: 60;
    height: auto;
    /* Every field the item has no longer fits a short terminal; the
       container scrolls the focused field into view instead. */
    max-height: 90%;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

NewItemDialog Label {
    margin-top: 1;
}

/* Dressed like an Input so the form reads as one column of fields, but
   these are displays: their values are made in the picker or $EDITOR,
   never typed here. */
NewItemDialog BlockerField,
NewItemDialog BodyField {
    height: 3;
    padding: 0 1;
    border: tall $panel;
}

NewItemDialog BlockerField:focus,
NewItemDialog BodyField:focus {
    border: tall $accent;
}

#dialog-title {
    text-style: bold;
    margin-top: 0;
}

#dialog-error {
    color: $error;
    margin-top: 1;
    height: 1;
}

#dialog-hint {
    color: $text-muted;
    margin-top: 1;
}

ConfirmDialog {
    align: center middle;
}

ConfirmDialog > #confirm-container {
    width: 40;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $error;
}

#confirm-hint {
    color: $text-muted;
    margin-top: 1;
}

SearchDialog {
    align: center middle;
}

SearchDialog > #search-container {
    width: 60;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

BlockDialog {
    align: center middle;
}

BlockDialog > #block-container {
    width: 60;
    height: auto;
    /* The inline error is the only place rejections are reported, so the
       box must never grow past the screen and clip its own bottom. */
    max-height: 100%;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

#block-title {
    text-style: bold;
    margin-bottom: 1;
}

#block-options {
    height: 1fr;
    min-height: 3;
    max-height: 12;
    margin-top: 1;
    border: none;
    background: $surface;
}

#block-error {
    color: $error;
    height: auto;
    margin-top: 1;
}

#block-hint {
    color: $text-muted;
    margin-top: 1;
}

ItemScreen {
    align: center middle;
}

ItemScreen > #item-container {
    /* Wide enough that the created/updated heading stays on one line at
       80 columns; it wraps rather than clips if an id or a done date
       pushes it over. */
    width: 92%;
    max-width: 96;
    /* Fixed height with the body preview as the only flexible part: on a
       short terminal the preview shrinks to nothing and the rows, the
       inline error and the hint all stay on screen. */
    height: 100%;
    max-height: 26;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

#item-heading {
    height: auto;
}

#item-fields {
    height: auto;
    max-height: 12;
    border: none;
    background: $surface;
}

#item-error {
    color: $error;
    height: auto;
    display: none;
}

#item-hint {
    color: $text-muted;
}

#item-body-scroll {
    height: 1fr;
    min-height: 0;
    border-top: solid $primary 30%;
    padding-top: 1;
    margin-top: 1;
}

TextPrompt, ChoicePrompt {
    align: center middle;
}

TextPrompt > #prompt-container, ChoicePrompt > #prompt-container {
    width: 60;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    background: $surface;
    border: thick $primary;
}

#prompt-title {
    text-style: bold;
    margin-bottom: 1;
}

#prompt-options {
    height: auto;
    max-height: 12;
    border: none;
    background: $surface;
}

#prompt-hint {
    color: $text-muted;
    margin-top: 1;
}
